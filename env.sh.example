# Copy to env.sh and fill in your own values. env.sh is gitignored.
# cp env.sh.example env.sh

# SSH host alias of the target machine (resolved from ~/.ssh/config).
REMOTE_HOST="WHS"

# MAC address used for Wake-on-LAN (find it: `getmac /v` on Windows, `ip link` on Linux).
WOL_MAC="AA:BB:CC:DD:EE:FF"

# Process name (regex) that front.sh brings to the foreground.
GAME_APP="MyGame"

# Optional: Windows username for front.sh (empty = default ssh user).
WIN_USER=""
